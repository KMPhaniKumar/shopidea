{
  "name": "reelmart-tests",
  "version": "1.0.0",
  "private": true,
  "description": "ReelMart test harness — Vitest + Supertest API tests, Playwright e2e, k6 performance",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run api",
    "test:web-api": "vitest run --config vitest.web-api.config.ts",
    "test:db": "vitest run db",
    "test:ui": "playwright test ui",
    "test:e2e": "playwright test e2e",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "supertest": "^7.1.3",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0",
    "zod": "^3.22.4"
  }
}
