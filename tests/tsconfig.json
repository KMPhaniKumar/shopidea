{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@payment-service/*": ["../reelmart/services/payment-service/src/*"],
      "@order-service/*": ["../reelmart/services/order-service/src/*"],
      "@payout-service/*": ["../reelmart/services/payout-service/src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
